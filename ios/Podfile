# Uncomment this line to define a global platform for your project
# MediaPipe (motion_camera) iOS 14 ister — 13'te pod çözümlemesi kırılıyor.
# M-F-263 zeyil-2 (Gravita'nın aştığı duvar), pin M-L-02 sabit.
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  # MediaPipe STATİK xcframework olarak geliyor; dinamik bağlamada kırılıyor.
  # `:linkage => :static` bu yüzden bir tercih değil, ŞART (zeyil-2).
  use_frameworks! :linkage => :static

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      definitions = Array(config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'])
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] =
        (definitions + ['$(inherited)', 'PERMISSION_CAMERA=1', 'PERMISSION_MICROPHONE=1']).uniq
    end
  end

  # RunnerTests is hosted by Runner. Loading the MediaPipe graph in both
  # binaries registers its calculators twice before XCTest can start.
  test_pods_targets = installer.aggregate_targets.select { |target| target.name == 'Pods-RunnerTests' }
  raise 'Expected exactly one Pods-RunnerTests target' unless test_pods_targets.length == 1

  test_pods = test_pods_targets.fetch(0)
  expected_test_graph_flags = {
    'OTHER_LDFLAGS[sdk=iphoneos*]' => '$(inherited) -force_load "$(PODS_ROOT)/MediaPipeTasksCommon/frameworks/graph_libraries/libMediaPipeTasksCommon_device_graph.a"',
    'OTHER_LDFLAGS[sdk=iphonesimulator*]' => '$(inherited) -force_load "${PODS_ROOT}/MediaPipeTasksCommon/frameworks/graph_libraries/libMediaPipeTasksCommon_simulator_graph.a"',
  }
  test_configs = test_pods.xcconfigs
  raise 'Unexpected RunnerTests configurations' unless test_configs.keys.sort == %w[Debug Profile Release]

  test_configs.each do |name, config|
    expected_test_graph_flags.each do |key, value|
      raise "Unexpected RunnerTests #{name} #{key}" unless config.attributes[key] == value
      config.attributes.delete(key)
    end
    config.save_as(test_pods.xcconfig_path(name))
  end
end
