<?xml version="1.0" encoding="utf-8"?>
<!-- OST-P0-08B: encrypted takes and their Keystore-wrapped key must not be
     restored separately (a restored file without its key is undecryptable). -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="file" path="encrypted_takes/" />
</full-backup-content>
